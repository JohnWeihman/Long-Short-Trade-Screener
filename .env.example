# Copy this file to .env and fill in your own details. .env is git-ignored.

# Required by the SEC on every request: your name and a contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: Anthropic API key for model-written memos (python -m screener.memos.build).
# Without it, memos use the fixed template. Each memo is one paid API call.
# ANTHROPIC_API_KEY=

# Optional: put the data cache somewhere other than ./data
# SCREENER_DATA_DIR=
